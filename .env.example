# Kopie als .env anlegen bzw. in systemd per EnvironmentFile laden. Echte Werte NIE committen.

# Flask Secret Key, erzeugen mit: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=bitte-aendern

# Max. Größe eines Uploads in MB (Standard: 200)
MAX_UPLOAD_MB=200

# Nur lokal zum Entwickeln: Debugger an (niemals auf dem Server)
# FLASK_DEBUG=1

# Optional: Bind-Adresse und Port beim Start mit "python main.py" (Standard: 127.0.0.1:5000)
# HOST=127.0.0.1
# PORT=5000
